FROM python:3.12-slim

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# Install system dependencies + Tesseract OCR for Nepali PDF extraction
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    tesseract-ocr \
    tesseract-ocr-nep \
    tesseract-ocr-hin \
    && rm -rf /var/lib/apt/lists/*

# Install lightweight Python dependencies (no torch/CUDA)
COPY requirements-prod.txt .
RUN pip install --no-cache-dir -r requirements-prod.txt
RUN python -m playwright install --with-deps chromium

# Copy application
COPY app/ app/
COPY app/tasks/ app/tasks/
COPY app/schemas/ app/schemas/
COPY app/utils/ app/utils/
COPY scripts/ scripts/
COPY config/ config/
COPY alembic/ alembic/
COPY alembic.ini .
COPY static/ static/

# Create non-root user
RUN useradd -m appuser && chown -R appuser:appuser /app /ms-playwright
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
