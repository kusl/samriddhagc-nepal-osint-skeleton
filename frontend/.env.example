# Environment Variables for Nepal OSINT Frontend
# Copy this file to .env.development or .env.production

# Backend API URL
# Development (v5): http://localhost:8000
# Production: https://api.yourdomain.com
VITE_API_URL=

# WebSocket URL for real-time updates
# Development (v5): ws://localhost:8000/ws
# Production: wss://api.yourdomain.com/ws
VITE_WS_URL=

# Google OAuth Client ID (from Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=

# Unified candidate reads (API snapshot first, local JSON fallback)
# false = keep legacy JSON-only mode
VITE_FEATURE_UNIFIED_CANDIDATE=false

# Investigation v2 rollout flags
VITE_FEATURE_INVESTIGATION_V2=false
VITE_FEATURE_GRAPH_FILTERS_PRO=false
VITE_FEATURE_GRAPH_CORRECTIONS=false
VITE_FEATURE_ANALYST_REPORT_DESK=true
VITE_FEATURE_INVESTIGATION_GRAPH_CONTEXT_ONLY=true
