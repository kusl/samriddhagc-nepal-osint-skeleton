# Pre-built static files — no node build needed on server
FROM nginx:alpine
COPY dist/ /usr/share/nginx/html

RUN cat > /etc/nginx/conf.d/default.conf <<'NGINX'
limit_req_zone $binary_remote_addr zone=api:10m rate=15r/s;
limit_conn_zone $binary_remote_addr zone=perip:10m;
resolver 127.0.0.11 valid=30s ipv6=off;
proxy_cache_path /var/cache/nginx/osint_api levels=1:2 keys_zone=osint_api_cache:10m max_size=128m inactive=10m use_temp_path=off;

map $request_method $osint_skip_cache {
    default 1;
    GET 0;
    HEAD 0;
}

server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    location ~* ^/api/v1/(dashboard/bootstrap|kpi/snapshot|stories/recent|map/events|announcements/summary|briefs/latest|analytics/developing-stories|govt-decisions/latest|cabinet-actions/(summary|items)|market/summary|economy/nrb-snapshot|debt-clock/nepal|procurement/widget-summary)$ {
        limit_req zone=api burst=30 nodelay;
        limit_conn perip 20;
        set $backend_upstream http://backend:8000;

        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;

        proxy_cache osint_api_cache;
        proxy_cache_key "$scheme$request_method$host$request_uri";
        proxy_cache_lock on;
        proxy_cache_background_update on;
        proxy_cache_use_stale updating error timeout invalid_header http_500 http_502 http_503 http_504;
        proxy_cache_valid 200 60s;
        proxy_cache_valid 404 10s;
        proxy_no_cache $osint_skip_cache;
        proxy_cache_bypass $osint_skip_cache;
        add_header X-Proxy-Cache $upstream_cache_status always;
    }

    # API proxy — rate limited
    location /api/ {
        limit_req zone=api burst=30 nodelay;
        limit_conn perip 20;
        set $backend_upstream http://backend:8000;

        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # WebSocket proxy
    location /ws {
        set $backend_upstream http://backend:8000;
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400s;
    }

    # Static assets — long cache
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # SPA fallback. Phones used to be rewritten here to a static
    # mobile-mockup-v2.html shell, which served a long-dead UI (National Brief,
    # Provincial Pulse, a Promises/Parliament bottom bar) that no longer exists
    # anywhere in src/. The real app handles small viewports itself now via
    # DesktopOnlyGate, so every user agent gets the SPA.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-store, no-cache, must-revalidate";
        add_header CDN-Cache-Control "no-store";
        add_header Surrogate-Control "no-store";
    add_header X-Build-Id "aviation-v59";
    }
}
NGINX

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
